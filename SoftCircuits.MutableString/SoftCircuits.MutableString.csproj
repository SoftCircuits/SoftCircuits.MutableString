<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0; net9.0; net8.0; net7.0; net6.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>SoftCircuits.MutableString</Title>
    <Version>1.0.1</Version>
    <Company>SoftCircuits</Company>
    <Authors>Jonathan Wood</Authors>
    <Description>Lightweight editable string class.</Description>
    <Copyright>Copyright © 2026 SoftCircuits</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/SoftCircuits/SoftCircuits.MutableString</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SoftCircuits/SoftCircuits.MutableString</RepositoryUrl>
    <PackageTags>string; mutable; mutable string</PackageTags>
    <PackageReleaseNotes>Added Replace overload that uses the string length as the replace count; misc.</PackageReleaseNotes>
    <PackageIcon>Logo_64x64.png</PackageIcon>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\Logo_64x64.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
